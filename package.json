{
  "name": "dms-grid",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "control",
    "mock-api",
    "harness"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "seed": "npm run seed --workspace @dms/mock-api",
    "mock": "npm run dev --workspace @dms/mock-api",
    "harness": "npm run dev --workspace @dms/harness",
    "dev": "concurrently -k -n mock,harness \"npm run mock\" \"npm run harness\"",
    "test": "jest --runInBand",
    "e2e": "playwright test",
    "build": "npm run build --workspace @dms/harness && npm run build --workspace @dms/mock-api",
    "build:pcf": "node scripts/build-pcf.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint control/DmsGrid harness/src mock-api/src mock-api/test e2e && prettier --check control/DmsGrid harness/src mock-api/src mock-api/test e2e",
    "format": "prettier --write control/DmsGrid harness/src mock-api/src mock-api/test e2e",
    "export:harness": "npm run build && node scripts/export-harness.mjs",
    "postinstall": "npm run refreshTypes --workspace @dms/control",
    "predev": "node scripts/ensure-seed.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.25.1",
    "@griffel/react": "1.5.32",
    "@microsoft/eslint-plugin-power-apps": "0.2.51",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "12.1.5",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.3",
    "@types/powerapps-component-framework": "1.3.18",
    "@types/react": "16.14.62",
    "@types/react-dom": "16.9.25",
    "@types/supertest": "^6.0.3",
    "archiver": "5.3.2",
    "concurrently": "9.1.2",
    "esbuild": "0.25.12",
    "eslint": "9.25.1",
    "eslint-plugin-promise": "7.1.0",
    "eslint-plugin-react": "7.37.2",
    "globals": "15.15.0",
    "jest": "29.7.0",
    "jest-axe": "10.0.0",
    "jest-environment-jsdom": "29.7.0",
    "prettier": "3.5.3",
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "supertest": "^7.1.0",
    "ts-jest": "29.2.6",
    "typescript": "5.8.3",
    "typescript-eslint": "8.44.0"
  },
  "overrides": {
    "@griffel/react": "1.5.32",
    "react": "$react",
    "react-dom": "$react-dom"
  }
}
